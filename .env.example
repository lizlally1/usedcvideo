# Copy this file to .env and fill in ONE provider's credentials to enable
# scripts/generate-voiceover.mjs to synthesize the final narration track.
# Never commit your real .env file — it is already git-ignored.

# Which provider to use: "elevenlabs" | "openai" | "polly" | "none"
VOICEOVER_PROVIDER=none

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- OpenAI TTS ---
OPENAI_API_KEY=
OPENAI_TTS_VOICE=onyx

# --- Amazon Polly ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
POLLY_VOICE_ID=Matthew
